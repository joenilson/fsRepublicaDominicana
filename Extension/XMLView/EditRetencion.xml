<view>
    <columns>
        <group name="data">
            <column name="withholding-tax" description="withholding-tax-desc" numcolumns="2" order="150">
                <widget type="select" fieldname="rdtipo" required="true">
                    <values title="ISR">ISR</values>
                    <values title="ITBIS">ITBIS</values>
                </widget>
            </column>
            <column name="isr-type-retention" description="isr-type-retention-desc" numcolumns="4" order="160">
                <widget type="select" fieldname="rdtipoisr">
                    <values title="-----"></values>
                    <values title="1 - Alquileres">1</values>
                    <values title="2 - Honorarios por servicios">2</values>
                    <values title="3 - Otras rentas">3</values>
                    <values title="4 - Otras rentas (rentas presuntas)">4</values>
                    <values title="5 - Intereses a personas jurídicas residentes">5</values>
                    <values title="6 - Intereses a personas físicas residentes">6</values>
                    <values title="7 - Proveedores del Estado">7</values>
                    <values title="8 - Juegos telefónicos">8</values>
                    <values title="9 - Ganadería de carne bovina">9</values>
                </widget>
            </column>
        </group>
    </columns>
</view>
